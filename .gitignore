# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
.flutter_tool_state
.flutter_settings
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Android 本地环境（含本机 SDK 绝对路径，禁止提交）
/android/local.properties
/android/.gradle/
/android/captures/
*.jks
*.keystore
/android/key.properties
# 兜底：签名配置若被挪到别处（如 android/app/key.properties）同样禁止入库
key.properties

# Gradle 缓存（放在工作区内，避免写用户目录下的 .gradle）
/.gradle-home/

# 真机走查截图（本地留证，不入库；报告见 docs/acceptance-*.md）
/shots/

# 构建产物（android/ 根级 build 目录）
/android/build/

# 待删临时目录（旧缓存搬运残留，可安全清理）
/.trash*/

# 真实账单样本（含隐私，只留本机）
test/fixtures/*-real.*

# 本机 agent 工作台（会话记忆 / 走查截图 / 一次性环境脚本 / 本地回收站）。
# 这些内容带着本机绝对路径与用户名，且只对这台机器有意义 —— 整个目录都不入库。
# 需要长期保留的方法论文档在 docs/dev/，通用脚本在 tool/。
/.workbuddy/

# 本机环境（含本机 SDK 绝对路径与用户名）—— 模板见 env.example.sh
/env.sh

# tool/ 下 Python 脚本的字节码缓存（此前无规则，`git add .` 会误入库）
__pycache__/
*.pyc
